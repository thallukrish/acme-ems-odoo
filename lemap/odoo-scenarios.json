{
  "enterpriseId": "acme-ems",
  "scenarios": [
    {
      "id": "demand-to-production-capacity",
      "actor": "sales_user",
      "start": {
        "model": "sale.order",
        "view": "form"
      },
      "fixtures": {
        "customer_apex": {
          "model": "res.partner",
          "domain": [
            [
              "name",
              "=",
              "Apex Industrial Controls Pvt Ltd"
            ]
          ],
          "field": "id"
        },
        "controller": {
          "model": "product.product",
          "domain": [
            [
              "default_code",
              "=",
              "FG-CTRL-100"
            ]
          ],
          "field": "id"
        }
      },
      "actions": [
        {
          "type": "open",
          "model": "sale.order"
        },
        {
          "type": "create",
          "saveAs": "runtime_sale_order_id",
          "values": {
            "partner_id": {
              "$ref": "customer_apex"
            },
            "client_order_ref": "LEMAP-RUNTIME-SO-001",
            "order_line": [
              [
                0,
                0,
                {
                  "product_id": {
                    "$ref": "controller"
                  },
                  "product_uom_qty": 25,
                  "price_unit": 9050
                }
              ]
            ]
          }
        },
        {
          "type": "click",
          "label": "Confirm"
        },
        {
          "type": "find",
          "model": "sale.order.line",
          "domain": [
            [
              "order_id",
              "=",
              {
                "$saved": "runtime_sale_order_id"
              }
            ]
          ],
          "saveAs": "runtime_sale_line_ids",
          "many": true,
          "require": true
        },
        {
          "type": "find",
          "model": "mrp.production",
          "domain": [
            [
              "sale_line_id",
              "in",
              {
                "$saved": "runtime_sale_line_ids"
              }
            ]
          ],
          "fields": [
            "bom_id",
            "workorder_ids",
            "ems_blocking_component_id",
            "ems_shortage_qty"
          ],
          "saveAs": "runtime_mo_ids",
          "many": true,
          "require": true
        },
        {
          "type": "open",
          "model": "mrp.production",
          "recordIds": {
            "$saved": "runtime_mo_ids"
          },
          "view": "form"
        },
        {
          "type": "read",
          "fields": [
            "bom_id"
          ],
          "saveAs": "runtime_bom_ids",
          "field": "bom_id",
          "many": true
        },
        {
          "type": "find",
          "model": "mrp.workorder",
          "domain": [
            [
              "production_id",
              "in",
              {
                "$saved": "runtime_mo_ids"
              }
            ]
          ],
          "fields": [
            "workcenter_id",
            "state"
          ],
          "saveAs": "runtime_workorder_ids",
          "many": true,
          "require": false
        },
        {
          "type": "open",
          "model": "mrp.workorder",
          "recordIds": {
            "$saved": "runtime_workorder_ids"
          },
          "view": "form"
        },
        {
          "type": "read",
          "fields": [
            "workcenter_id"
          ],
          "saveAs": "runtime_workcenter_ids",
          "field": "workcenter_id",
          "many": true
        },
        {
          "type": "find",
          "model": "mrp.workcenter",
          "domain": [
            [
              "id",
              "in",
              {
                "$saved": "runtime_workcenter_ids"
              }
            ]
          ],
          "fields": [
            "ems_actual_units_per_day",
            "ems_queue_units",
            "ems_downtime_hours_month"
          ],
          "require": false
        },
        {
          "type": "open",
          "model": "mrp.workcenter",
          "recordIds": {
            "$saved": "runtime_workcenter_ids"
          },
          "view": "form"
        },
        {
          "type": "find",
          "model": "acme.rework.event",
          "domain": [
            [
              "production_id",
              "in",
              {
                "$saved": "runtime_mo_ids"
              }
            ]
          ],
          "require": false
        },
        {
          "type": "find",
          "model": "acme.test.result",
          "domain": [
            [
              "production_id",
              "in",
              {
                "$saved": "runtime_mo_ids"
              }
            ]
          ],
          "require": false
        }
      ],
      "expectedBusinessOutcome": [
        "sale confirmed",
        "manufacturing order created from the runtime sale",
        "BOM and work-center neighborhood reached",
        "capacity evidence queried; quality and rework are separate downstream scenarios"
      ]
    },
    {
      "id": "production-quality-cost",
      "actor": "operations_user",
      "start": {
        "model": "mrp.production",
        "view": "form"
      },
      "fixtures": {
        "capacity_mo": {
          "model": "mrp.production",
          "domain": [
            [
              "ems_delay_reason",
              "=",
              "capacity"
            ]
          ],
          "field": "id"
        },
        "controller": {
          "model": "product.product",
          "domain": [
            [
              "default_code",
              "=",
              "FG-CTRL-100"
            ]
          ],
          "field": "id"
        },
        "component_mcu": {
          "model": "product.product",
          "domain": [
            [
              "default_code",
              "=",
              "IC-MCU-H7"
            ]
          ],
          "field": "id"
        },
        "component_lot": {
          "model": "stock.lot",
          "domain": [
            [
              "name",
              "=",
              "MCU-LOT-2608-A"
            ]
          ],
          "field": "id"
        },
        "finished_lot": {
          "model": "stock.lot",
          "domain": [
            [
              "name",
              "=",
              "CTRL-C-2609-001"
            ]
          ],
          "field": "id"
        },
        "component_supplier": {
          "model": "res.partner",
          "domain": [
            [
              "name",
              "=",
              "FastChip Components India"
            ]
          ],
          "field": "id"
        }
      },
      "actions": [
        {
          "type": "open",
          "model": "mrp.production"
        },
        {
          "type": "find",
          "model": "mrp.production",
          "domain": [
            [
              "id",
              "=",
              {
                "$ref": "capacity_mo"
              }
            ]
          ],
          "fields": [
            "product_id",
            "bom_id",
            "workorder_ids"
          ],
          "saveAs": "capacity_mo_id",
          "require": true
        },
        {
          "type": "read",
          "fields": [
            "product_id"
          ],
          "saveAs": "runtime_mo_product_id",
          "field": "product_id"
        },
        {
          "type": "open",
          "model": "acme.test.result",
          "view": "form"
        },
        {
          "type": "create",
          "model": "acme.test.result",
          "saveAs": "runtime_failed_test_id",
          "values": {
            "name": "LEMAP-RUNTIME-FT-FAIL",
            "production_id": {
              "$saved": "capacity_mo_id"
            },
            "finished_lot_id": {
              "$ref": "finished_lot"
            },
            "result": "fail",
            "failure_code": "ETH-LINK",
            "cycle_minutes": 9.4
          }
        },
        {
          "type": "open",
          "model": "acme.rework.event",
          "view": "form"
        },
        {
          "type": "create",
          "model": "acme.rework.event",
          "saveAs": "runtime_rework_id",
          "values": {
            "name": "LEMAP-RUNTIME-REWORK",
            "production_id": {
              "$saved": "capacity_mo_id"
            },
            "event_type": "rework",
            "reason_code": "ETH-LINK",
            "quantity": 1,
            "labor_hours": 1,
            "labor_cost": 1200,
            "material_cost": 300,
            "external_cost": 0
          }
        },
        {
          "type": "open",
          "model": "acme.lot.trace",
          "view": "form"
        },
        {
          "type": "create",
          "model": "acme.lot.trace",
          "saveAs": "runtime_trace_id",
          "values": {
            "production_id": {
              "$saved": "capacity_mo_id"
            },
            "component_product_id": {
              "$ref": "component_mcu"
            },
            "component_lot_id": {
              "$ref": "component_lot"
            },
            "component_supplier_id": {
              "$ref": "component_supplier"
            },
            "consumed_qty": 1,
            "finished_product_id": {
              "$saved": "runtime_mo_product_id"
            },
            "finished_lot_id": {
              "$ref": "finished_lot"
            }
          }
        },
        {
          "type": "find",
          "model": "acme.rework.event",
          "domain": [
            [
              "production_id",
              "=",
              {
                "$saved": "capacity_mo_id"
              }
            ]
          ],
          "fields": [
            "event_type",
            "quantity",
            "labor_cost",
            "material_cost",
            "external_cost"
          ],
          "require": true
        },
        {
          "type": "find",
          "model": "acme.test.result",
          "domain": [
            [
              "production_id",
              "=",
              {
                "$saved": "capacity_mo_id"
              }
            ]
          ],
          "fields": [
            "result",
            "failure_code",
            "cycle_minutes",
            "workcenter_id"
          ],
          "require": true
        },
        {
          "type": "find",
          "model": "acme.lot.trace",
          "domain": [
            [
              "production_id",
              "=",
              {
                "$saved": "capacity_mo_id"
              }
            ]
          ],
          "fields": [
            "component_product_id",
            "component_supplier_id",
            "finished_product_id",
            "finished_lot_id"
          ],
          "require": true
        },
        {
          "type": "find",
          "model": "acme.product.cost.snapshot",
          "domain": [
            [
              "product_id",
              "=",
              {
                "$saved": "runtime_mo_product_id"
              }
            ]
          ],
          "fields": [
            "period_date",
            "material_unit_cost",
            "conversion_unit_cost",
            "rework_scrap_unit_cost",
            "freight_expedite_unit_cost"
          ],
          "require": true
        }
      ],
      "expectedBusinessOutcome": [
        "existing production order and its product identified",
        "failed functional test recorded against the selected MO",
        "rework event separately recorded against the same MO",
        "component-to-finished-lot trace recorded against the same MO",
        "quality, rework and lot records retrieved by production_id",
        "historical product cost snapshots retrieved by the MO product; snapshots remain seeded history, not generated by MO confirmation"
      ]
    },
    {
      "id": "bom-to-sourcing",
      "actor": "procurement_user",
      "start": {
        "model": "mrp.bom",
        "view": "form"
      },
      "fixtures": {
        "controller_template": {
          "model": "product.template",
          "domain": [
            [
              "default_code",
              "=",
              "FG-CTRL-100"
            ]
          ],
          "field": "id"
        },
        "mcu_template": {
          "model": "product.template",
          "domain": [
            [
              "default_code",
              "=",
              "IC-MCU-H7"
            ]
          ],
          "field": "id"
        }
      },
      "actions": [
        {
          "type": "open",
          "model": "mrp.bom"
        },
        {
          "type": "find",
          "model": "mrp.bom",
          "domain": [
            [
              "product_tmpl_id",
              "=",
              {
                "$ref": "controller_template"
              }
            ]
          ],
          "fields": [
            "bom_line_ids",
            "operation_ids"
          ],
          "saveAs": "controller_bom_ids",
          "many": true,
          "require": true
        },
        {
          "type": "find",
          "model": "mrp.bom.line",
          "domain": [
            [
              "bom_id",
              "in",
              {
                "$saved": "controller_bom_ids"
              }
            ]
          ],
          "fields": [
            "product_id",
            "product_qty"
          ],
          "saveAs": "bom_line_ids",
          "many": true,
          "require": true
        },
        {
          "type": "read",
          "fields": [
            "product_id"
          ],
          "saveAs": "bom_component_product_ids",
          "field": "product_id",
          "many": true
        },
        {
          "type": "find",
          "model": "acme.manufacturer.part",
          "domain": [
            [
              "product_tmpl_id",
              "=",
              {
                "$ref": "mcu_template"
              }
            ]
          ],
          "fields": [
            "manufacturer_name",
            "mpn",
            "is_preferred",
            "lifecycle_state"
          ],
          "saveAs": "mcu_manufacturer_part_ids",
          "many": true,
          "require": true
        },
        {
          "type": "find",
          "model": "acme.approved.supply",
          "domain": [
            [
              "manufacturer_part_id",
              "in",
              {
                "$saved": "mcu_manufacturer_part_ids"
              }
            ]
          ],
          "fields": [
            "supplier_id",
            "approval_state",
            "is_preferred",
            "moq",
            "lead_time_days",
            "unit_price",
            "freight_cost_per_unit",
            "expedite_premium_per_unit",
            "on_time_delivery_pct",
            "quality_acceptance_pct"
          ],
          "require": true
        }
      ],
      "expectedBusinessOutcome": [
        "finished-product BOM reached",
        "component neighborhood reached",
        "MCU manufacturer-part alternatives reached",
        "approved supplier trade-offs reached"
      ]
    }
  ]
}
